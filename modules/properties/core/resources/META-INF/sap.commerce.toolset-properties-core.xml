<idea-plugin>

    <extensions defaultExtensionNs="com.intellij">
        <platform.backend.documentation.psiTargetProvider
                implementation="sap.commerce.toolset.properties.lang.documentation.CxPropertyPsiDocumentationTargetProvider"/>

        <completion.contributor language="Properties"
                                implementationClass="sap.commerce.toolset.properties.codeInsight.completion.CxPropertyCompletionContributor"/>

        <psi.referenceContributor language="Properties"
                                  implementation="sap.commerce.toolset.properties.psi.contributor.CxPropertyReferenceContributor"/>

        <codeInsight.inlayProvider language="Properties"
                                   implementationClass="sap.commerce.toolset.properties.codeInsight.hints.CxPropertiesInlayHintsProvider"/>

        <localInspection groupPath="SAP Commerce" shortName="CxEnvironmentPropertyInExtensionInspection"
                         displayName="[y] Environment-specific property declared in an extension"
                         groupName="[y] Properties" level="ERROR" language="Properties" enabledByDefault="true"
                         implementationClass="sap.commerce.toolset.properties.codeInspection.CxEnvironmentPropertyInExtensionInspection"/>

        <localInspection groupPath="SAP Commerce" shortName="CxUnresolvedPropertyPlaceholderInspection"
                         displayName="[y] Unresolvable property placeholder"
                         groupName="[y] Properties" level="WARNING" language="Properties" enabledByDefault="true"
                         implementationClass="sap.commerce.toolset.properties.codeInspection.CxUnresolvedPropertyPlaceholderInspection"/>

        <localInspection groupPath="SAP Commerce" shortName="CxShadowedPropertyInspection"
                         displayName="[y] Property declaration which never applies"
                         groupName="[y] Properties" level="WARNING" language="Properties" enabledByDefault="true"
                         implementationClass="sap.commerce.toolset.properties.codeInspection.CxShadowedPropertyInspection"/>

        <localInspection groupPath="SAP Commerce" shortName="CxManagedPropertyInspection"
                         displayName="[y] Property managed by SAP Commerce Cloud"
                         groupName="[y] Properties" level="WARNING" language="Properties" enabledByDefault="true"
                         implementationClass="sap.commerce.toolset.properties.codeInspection.CxManagedPropertyInspection"/>
    </extensions>
</idea-plugin>
